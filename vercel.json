{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/taskboard", "destination": "/taskboard/index.html" },
    { "source": "/taskboard/:path*", "destination": "/taskboard/index.html" }
  ]
}
