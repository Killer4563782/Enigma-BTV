{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/taskboard/*"],
      "@enigma/session": ["./src/shared/session.ts"]
    }
  },
  "include": ["src/taskboard/**/*.ts", "src/taskboard/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
