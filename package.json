{
  "name": "enigma-remastered",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run typecheck && astro build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "node src/scripts/preview.mjs",
    "start": "node src/scripts/preview.mjs",
    "test:transfer": "node --test src/tests/*-transfer.test.mjs",
    "assets": "node src/scripts/optimize-assets.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "lucide-react": "^0.577.0",
    "motion": "^13.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "astro": "^7.3.8",
    "@astrojs/react": "^7.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
