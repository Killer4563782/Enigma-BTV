---
import TaskboardApp from '../taskboard/TaskboardApp';
import '@fontsource-variable/inter';
import '../taskboard/app/globals.css';
import '../taskboard/app/refinements.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="A thoughtful workspace for the people building Enigma." />
    <title>Enigma Taskboard — A little more in sync</title>
  </head>
  <body>
    <div id="taskboard-root">
      <TaskboardApp client:only="react">
        <p slot="fallback" role="status">Loading your workspace…</p>
      </TaskboardApp>
    </div>
  </body>
</html>
